# X-Router integration (server-side only — never expose keys to the browser)
# Keep MARKETPLACE_ENABLED=false to run the site on mock data.

XROUTER_URL=http://localhost:3100
MARKETPLACE_ENABLED=false
# Dedicated /provision/* auth dimension — reads (wallet/earnings/plans/usage…),
# writes (create-key, grant, top-up, seller, markup), and webhook config.
XROUTER_PROVISION_KEY=provision-key-1
# Admin key for /admin/v1/* (plan CRUD, canonical, seller terms). Server-only,
# gated by FOZA_ADMIN_EMAILS. Matches X-Router ADMIN_API_KEYS.
XROUTER_ADMIN_KEY=admin-key-1
# Internal key for end-user LLM calls (/v1/*) and public reads.
XROUTER_INTERNAL_KEY=dev-key-1
# Shared secret X-Router signs business webhooks with (HMAC-SHA256, X-Provision-Signature).
XROUTER_WEBHOOK_SECRET=change-me

# --- Auth.js (Foza owns user identity) ---
# Signs the JWT session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Google OAuth client (https://console.cloud.google.com -> Credentials).
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL for verification links in emails.
AUTH_URL=http://localhost:3001
# Gmail SMTP for verification emails. SMTP_PASS = a Google App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave blank to log the verify link to the server console instead of sending.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
