{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": { "$value": "#f6f8fb", "$type": "color", "$description": "Canvas — primary page background (light theme)" },
    "foreground": { "$value": "#111827", "$type": "color", "$description": "Ink — primary text and headings" },
    "card": { "$value": "#ffffff", "$type": "color", "$description": "Card — panel / card surface floating on the canvas" },
    "card-foreground": { "$value": "#111827", "$type": "color", "$description": "Text on card surfaces" },
    "sidebar": { "$value": "#ffffff", "$type": "color", "$description": "Sidebar / navigation surface" },
    "sidebar-foreground": { "$value": "#374151", "$type": "color", "$description": "Sidebar / secondary navigation text" },
    "primary": { "$value": "#1473ff", "$type": "color", "$description": "Primary Blue — buttons, links, focus ring, brand. The single accent." },
    "primary-foreground": { "$value": "#ffffff", "$type": "color", "$description": "Text/icons on primary blue" },
    "secondary": { "$value": "#e9ecf0", "$type": "color", "$description": "Secondary button / chip surface" },
    "secondary-foreground": { "$value": "#374151", "$type": "color", "$description": "Text on secondary surface" },
    "muted": { "$value": "#e9ecf0", "$type": "color", "$description": "Muted fills, skeletons, progress tracks" },
    "muted-foreground": { "$value": "#6b7280", "$type": "color", "$description": "Ink Muted — secondary text, captions, table labels" },
    "accent": { "$value": "#e8f1ff", "$type": "color", "$description": "Accent Wash — soft blue background for badges and eyebrows" },
    "accent-foreground": { "$value": "#0d55c4", "$type": "color", "$description": "Text on accent wash" },
    "border": { "$value": "#dde1e7", "$type": "color", "$description": "Hairline — borders, dividers, the primary elevation cue" },
    "input": { "$value": "#dde1e7", "$type": "color", "$description": "Input border" },
    "ring": { "$value": "#1473ff", "$type": "color", "$description": "Focus ring" },
    "success": { "$value": "#16a34a", "$type": "color", "$description": "Positive status, uptime, gains" },
    "warning": { "$value": "#d97706", "$type": "color", "$description": "Warning status" },
    "destructive": { "$value": "#dc2626", "$type": "color", "$description": "Error / destructive action" }
  },
  "code": {
    "bg": { "$value": "#0d1117", "$type": "color", "$description": "Code block / terminal background (theme-independent)" },
    "header": { "$value": "#161b22", "$type": "color", "$description": "Code block title bar" },
    "foreground": { "$value": "#e6edf3", "$type": "color", "$description": "Code text" },
    "muted": { "$value": "#8b949e", "$type": "color", "$description": "Comments, line numbers" },
    "hover": { "$value": "rgba(255,255,255,0.1)", "$type": "color", "$description": "Row hover in code" },
    "highlight": { "$value": "rgba(77,142,255,0.1)", "$type": "color", "$description": "Highlighted code line" }
  },
  "dark": {
    "background": { "$value": "#0d0d14", "$type": "color", "$description": "Dark theme canvas" },
    "foreground": { "$value": "#f1f1f4", "$type": "color", "$description": "Dark theme primary text" },
    "card": { "$value": "#1c1c2e", "$type": "color", "$description": "Dark theme card surface" },
    "sidebar": { "$value": "#0f0f1a", "$type": "color", "$description": "Dark theme sidebar surface" },
    "primary": { "$value": "#4d8eff", "$type": "color", "$description": "Dark theme primary blue" },
    "accent": { "$value": "#0c1f45", "$type": "color", "$description": "Dark theme accent wash" },
    "accent-foreground": { "$value": "#80aeff", "$type": "color", "$description": "Dark theme accent text" },
    "border": { "$value": "#252535", "$type": "color", "$description": "Dark theme border / input" }
  },
  "font": {
    "sans": { "$value": "\"Lexend\", \"Lexend Fallback\", ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily", "$description": "Lexend — humanist variable sans, the single brand typeface" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace", "$type": "fontFamily", "$description": "Monospace — code, terminals, API keys only" }
  },
  "fontWeight": {
    "normal": { "$value": 400, "$type": "fontWeight", "$description": "Body text" },
    "medium": { "$value": 500, "$type": "fontWeight", "$description": "Buttons, nav, labels" },
    "semibold": { "$value": 600, "$type": "fontWeight", "$description": "Card titles, subheadings" },
    "bold": { "$value": 700, "$type": "fontWeight", "$description": "Display headings, stat values, wordmark" }
  },
  "text": {
    "xs": { "$value": "0.75rem", "$type": "dimension", "$description": "micro — eyebrow/labels (12px), tracking 0.05em" },
    "sm": { "$value": "0.875rem", "$type": "dimension", "$description": "caption — table data, captions (14px)" },
    "base": { "$value": "1rem", "$type": "dimension", "$description": "body (16px), leading 1.625" },
    "lg": { "$value": "1.125rem", "$type": "dimension", "$description": "body-lg / card title (18px)" },
    "xl": { "$value": "1.25rem", "$type": "dimension", "$description": "subheading (20px)" },
    "2xl": { "$value": "1.5rem", "$type": "dimension", "$description": "heading-sm (24px), tracking -0.025em" },
    "3xl": { "$value": "1.875rem", "$type": "dimension", "$description": "heading / stat value (30px)" },
    "4xl": { "$value": "2.25rem", "$type": "dimension", "$description": "heading-lg (36px)" },
    "5xl": { "$value": "3rem", "$type": "dimension", "$description": "display-sm (48px)" },
    "6xl": { "$value": "3.75rem", "$type": "dimension", "$description": "display / hero (60px)" },
    "7xl": { "$value": "4.5rem", "$type": "dimension", "$description": "display-lg (72px)" }
  },
  "tracking": {
    "tight": { "$value": "-0.025em", "$type": "dimension", "$description": "Headlines — the Lexend display voice" },
    "wider": { "$value": "0.05em", "$type": "dimension", "$description": "Eyebrow / label caps" },
    "widest": { "$value": "0.1em", "$type": "dimension", "$description": "Widest tracking, rare" }
  },
  "leading": {
    "tight": { "$value": "1.25", "$type": "number", "$description": "Display headings" },
    "snug": { "$value": "1.375", "$type": "number", "$description": "heading-sm" },
    "normal": { "$value": "1.5", "$type": "number", "$description": "Default UI / captions" },
    "relaxed": { "$value": "1.625", "$type": "number", "$description": "Body paragraphs" }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension", "$description": "Base unit" },
    "2": { "$value": "8px", "$type": "dimension", "$description": "Tight gap" },
    "3": { "$value": "12px", "$type": "dimension", "$description": "Input padding" },
    "4": { "$value": "16px", "$type": "dimension", "$description": "Element gap" },
    "5": { "$value": "20px", "$type": "dimension", "$description": "Element gap (lg)" },
    "6": { "$value": "24px", "$type": "dimension", "$description": "Card padding" },
    "8": { "$value": "32px", "$type": "dimension", "$description": "Block gap" },
    "10": { "$value": "40px", "$type": "dimension", "$description": "Block gap (lg)" },
    "12": { "$value": "48px", "$type": "dimension", "$description": "Sub-section gap" },
    "16": { "$value": "64px", "$type": "dimension", "$description": "Section gap (sm)" },
    "20": { "$value": "80px", "$type": "dimension", "$description": "Section gap" },
    "24": { "$value": "96px", "$type": "dimension", "$description": "Section gap (lg)" },
    "32": { "$value": "128px", "$type": "dimension", "$description": "Hero / major section gap" }
  },
  "radius": {
    "DEFAULT": { "$value": "0.3rem", "$type": "dimension", "$description": "Buttons, inputs, default" },
    "sm": { "$value": "calc(0.3rem - 2px)", "$type": "dimension", "$description": "Small inner elements" },
    "xl": { "$value": "0.75rem", "$type": "dimension", "$description": "Cards" },
    "2xl": { "$value": "1rem", "$type": "dimension", "$description": "Large cards / panels" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Badges, chips, pills" }
  }
}
